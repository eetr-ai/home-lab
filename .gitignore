# Secrets and environment files
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
# Google Cloud service account keys. scripts/create-registry-secret.sh writes
# these to a temporary directory outside the repository; these patterns catch
# one created by hand before it can be committed.
key.json
*-key.json
home-lab-*.json
*.p12
*.pfx
*.kubeconfig
kubeconfig

# Terraform and OpenTofu
**/.terraform/*
**/.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Locally rendered cloud-init data
cloud-init/*.yaml
!cloud-init/*.yaml.example
**/seed.iso

# Ansible
*.retry
ansible/collections/
ansible/inventory/hosts.yml
ansible/artifacts/

# Generated and local files
.DS_Store
**/values.local.yaml
# Local values for a standalone upstream chart, holding the credentials the
# committed helm-values/<chart>.yaml beside it deliberately does not.
helm-values/*.local.yaml
**/charts/*.tgz
rendered-*.yaml
*.swp
*.swo
*.tmp
*.log
.idea/
.vscode/

# VM images and archives
*.qcow2
*.img
*.iso
*.ova
*.tar
*.tar.gz

# Node and the admin web app
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
coverage/
.npm/

# Go and the admin API
admin/api/bin/
dist/

# go-task
.task/

# The agent's local run directory: `task admin-agent:run` mounts it as /data, so
# it holds whatever a local conversation left behind — the KV store and the
# workspace. The cluster's equivalent is a PVC.
admin/agent/.local/
