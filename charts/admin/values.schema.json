{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["admin"],
  "properties": {
    "admin": {
      "type": "object",
      "required": ["imagePullSecrets", "gateway", "api"],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "gateway": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "api": {
          "type": "object",
          "required": ["image", "replicas", "resources", "route", "oidc"],
          "properties": {
            "oidc": {
              "type": "object",
              "required": ["issuer"],
              "properties": {
                "issuer": {
                  "type": "string",
                  "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]+)?(/.*)?$",
                  "description": "The OpenID Connect issuer URL, exactly as the provider publishes it."
                },
                "audience": { "type": "string" }
              }
            },
            "image": {
              "type": "object",
              "required": ["repository", "tag", "pullPolicy"],
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "not": { "const": "latest" },
                  "description": "An immutable tag. \"latest\" is refused: a pod pulling a moving name cannot say which build it is running."
                },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "replicas": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" },
            "route": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "hostname": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
