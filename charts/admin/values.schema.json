{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "admin"
  ],
  "properties": {
    "admin": {
      "type": "object",
      "required": [
        "imagePullSecrets",
        "image",
        "gateway",
        "api",
        "web",
        "agent"
      ],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": {
              "type": "string",
              "not": {
                "const": "latest"
              },
              "description": "An immutable tag for all three images. Empty means the chart's own appVersion, which is the version the images were published under. \"latest\" is refused: a pod pulling a moving name cannot say which build it is running."
            }
          }
        },
        "gateway": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "api": {
          "type": "object",
          "required": [
            "image",
            "replicas",
            "resources",
            "route",
            "oidc",
            "postgres",
            "mongo",
            "kubernetes",
            "helm"
          ],
          "properties": {
            "kubernetes": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespaces": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "manage": {
                      "type": "boolean",
                      "description": "Let the panel create and delete namespaces. Grants create and delete on namespaces cluster-wide; what bounds it is the API's protection policy, not RBAC."
                    },
                    "protected": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                      },
                      "description": "Namespaces the panel may never delete, on top of the built-in rules and its own namespace."
                    },
                    "podSecurity": {
                      "enum": [
                        "privileged",
                        "baseline",
                        "restricted"
                      ],
                      "description": "The Pod Security admission level stamped on a namespace the panel creates."
                    }
                  }
                }
              }
            },
            "postgres": {
              "$ref": "#/$defs/managedService"
            },
            "mongo": {
              "$ref": "#/$defs/managedService"
            },
            "oidc": {
              "type": "object",
              "required": [
                "issuer"
              ],
              "properties": {
                "issuer": {
                  "type": "string",
                  "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]+)?(/.*)?$",
                  "description": "The OpenID Connect issuer URL, exactly as the provider publishes it."
                },
                "audience": {
                  "type": "string"
                }
              }
            },
            "image": {
              "$ref": "#/$defs/image"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            },
            "route": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "hostname": {
                  "type": "string"
                }
              }
            },
            "helm": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespaces": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "description": "Namespaces the panel may deploy Helm releases into. Each renders a Role granting read on EVERY Secret in that namespace; see templates/api/rbac-deploy.yaml."
                },
                "allNamespaces": {
                  "type": "boolean",
                  "description": "Deploy into every unprotected namespace instead of the list above. Renders one ClusterRole in place of the per-namespace Roles, which means the panel can read every Secret in every unprotected namespace. Needed for 'create a namespace, then deploy into it', because the per-namespace Roles are rendered at install time."
                },
                "postgres": {
                  "$ref": "#/$defs/managedService",
                  "description": "Where declared deployments and their versioned values are kept. Its own database and role, not the superuser DSN the panel administers PostgreSQL with. Disabled leaves the deployment routes answering 501."
                },
                "job": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "The Job that performs one Helm operation. It runs the API's own image under a subcommand, so there is deliberately no image or serviceAccount override: the design rests on it being the same binary, and which identity it runs as is a security property of this chart rather than a preference.",
                  "properties": {
                    "ttlSecondsAfterFinished": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "How long a finished Helm Job and its log are kept. The log is a view, not the record - what survives is Helm's release history and the rollout stamp in PostgreSQL."
                    },
                    "resources": {
                      "type": "object",
                      "description": "Resource requests and limits for the Helm Job's pod."
                    }
                  }
                }
              }
            }
          }
        },
        "web": {
          "type": "object",
          "required": [
            "hostname",
            "authUrl",
            "clientId",
            "providerName",
            "secret",
            "image",
            "replicas",
            "resources",
            "redis"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$",
              "description": "The hostname the panel is served on. A bare host, not a URL: the chart builds the HTTPRoute from it, and AUTH_URL too unless admin.web.authUrl overrides that."
            },
            "authUrl": {
              "type": "string",
              "pattern": "^$|^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:([0-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
              "description": "The origin the browser actually reaches the panel on, when that is not https://<hostname>. Empty derives it, which is what a real install wants; this is for a local cluster behind a port-forward. An origin only -- no path, since Auth.js appends the callback. Whatever is set must be registered with eetr-auth as <authUrl>/api/auth/callback/eetr."
            },
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "providerName": {
              "type": "string",
              "minLength": 1
            },
            "writeEmails": {
              "type": "string"
            },
            "secret": {
              "type": "object",
              "required": [
                "name",
                "authSecretKey",
                "clientSecretKey"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "authSecretKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "image": {
              "$ref": "#/$defs/image"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            },
            "redis": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "secret": {
                  "type": "object",
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "url",
                  "secret"
                ]
              },
              "required": [
                "enabled"
              ]
            }
          }
        },
        "agent": {
          "type": "object",
          "required": [
            "enabled",
            "model",
            "reasoning",
            "secret",
            "storage",
            "image",
            "resources"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9-]+/[A-Za-z0-9._-]+(:[A-Za-z0-9-]+)?$",
              "description": "A vendor-prefixed OpenRouter model id, e.g. deepseek/deepseek-v4-flash. There is no bare model name there."
            },
            "reasoning": {
              "enum": [
                "default",
                "none",
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "description": "Reasoning effort. The connector validates this at startup, so an unlisted value is a pod that will not start."
            },
            "secret": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "storage": {
              "type": "object",
              "required": [
                "className",
                "size"
              ],
              "properties": {
                "className": {
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|Ti)$"
                }
              }
            },
            "image": {
              "$ref": "#/$defs/image"
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "managedService": {
      "type": "object",
      "required": [
        "enabled",
        "secret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
