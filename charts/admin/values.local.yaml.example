# Copy to charts/admin/values.local.yaml, which is ignored, and replace the
# placeholders with the real registry path, hostname, and the version you intend
# to run.

admin:
  # One tag for all three images: one release tag builds them all, so there is
  # one key rather than three that have to be kept saying the same thing.
  image:
    tag: "0.1.0"

  api:
    image:
      repository: us-west1-docker.pkg.dev/YOUR_PROJECT/home-lab/admin-api
    oidc:
      issuer: https://auth.eetr.app
      audience: YOUR_ADMIN_PANEL_CLIENT_ID

  web:
    hostname: admin.example.invalid
    clientId: YOUR_ADMIN_PANEL_CLIENT_ID
    image:
      repository: us-west1-docker.pkg.dev/YOUR_PROJECT/home-lab/admin-web

  # The assistant. Off by default in values.yaml, because it costs money per
  # answer and needs a provider key. Before enabling it:
  #
  #   kubectl -n admin create secret generic admin-agent-llm \
  #     --from-literal=apiKey=sk-or-...
  agent:
    enabled: true
    image:
      repository: us-west1-docker.pkg.dev/YOUR_PROJECT/home-lab/admin-agent
