# Copy this file to values.local.yaml. The copy is ignored by Git.
platform:
  baseDomain: example.com
  acmeEmail: operator@example.com
  # Domains served beside baseDomain, one entry per application publishing under
  # a zone of its own. Uncomment and adapt; the DNS-01 token below has to be able
  # to edit every zone named here.
  # gateway:
  #   additionalDomains:
  #     - name: example-app
  #       tlsSecretName: example-app-tls
  #       hostnames:
  #         - app.example.invalid
  #         - "*.apps.app.example.invalid"

  issuers:
    enabled: true
    cloudflareApiTokenSecret:
      name: cloudflare-api-token
      key: api-token
  cloudflared:
    enabled: true
    tunnelTokenSecret:
      name: cloudflared-token
      key: token
  whoami:
    enabled: true
    hostname: whoami.example.com

nfs-provisioner:
  nfs:
    # RFC 5737 documentation address; replace it only in values.local.yaml.
    server: 192.0.2.1
    path: /export/kubernetes
