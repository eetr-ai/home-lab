{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "platform",
    "nfs-provisioner"
  ],
  "properties": {
    "platform": {
      "type": "object",
      "required": [
        "baseDomain",
        "acmeEmail",
        "gateway",
        "issuers",
        "cloudflared",
        "whoami",
        "redis"
      ],
      "properties": {
        "baseDomain": {
          "type": "string",
          "minLength": 1
        },
        "acmeEmail": {
          "type": "string",
          "minLength": 3
        },
        "gateway": {
          "type": "object",
          "properties": {
            "additionalDomains": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "tlsSecretName", "hostnames"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "tlsSecretName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "hostnames": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253,
                      "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"
                    }
                  }
                }
              }
            }
          }
        },
        "issuers": {
          "type": "object"
        },
        "cloudflared": {
          "type": "object"
        },
        "whoami": {
          "type": "object"
        },
        "redis": {
          "type": "object",
          "properties": {
            "passwordSecret": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "passwordSecret"
            ]
          },
          "required": [
            "enabled"
          ]
        }
      }
    },
    "metrics-server": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "nfs-provisioner": {
      "type": "object",
      "required": [
        "nfs"
      ],
      "properties": {
        "nfs": {
          "type": "object",
          "required": [
            "server",
            "path"
          ],
          "properties": {
            "server": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    }
  }
}
