# Copy this file to admin/.env and replace every example value. The real file is
# ignored by Git and holds both a client secret and two superuser passwords, so
# keep it mode 0600 and never paste its contents anywhere.
#
#   cp admin/.env.example admin/.env && chmod 600 admin/.env
#
# Used by `task dev` (admin/compose.yaml) only. The deployed panel reads none of
# this: the chart supplies the same values from Kubernetes Secrets.

# ── Identity ────────────────────────────────────────────────────────────────
# The eetr-auth instance, exactly as it spells its own issuer. The API checks
# tokens against this string, so a trailing slash here and not there rejects
# every token.
OIDC_ISSUER=https://auth.example.invalid

# The confidential client registered in eetr-auth for this panel:
#   - token endpoint auth: client_secret_basic
#   - scopes: openid profile email
#   - redirect URIs: http://localhost:3000/api/auth/callback/eetr
#                    and the deployed panel's equivalent
# Your account must also be granted this client's environment, or eetr-auth
# answers access_denied at /authorize however administrative you are.
OIDC_CLIENT_ID=replace_with_the_client_id
OIDC_CLIENT_SECRET=replace_with_the_client_secret

# Seals the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_string

# The panel's own origin. Must match a registered redirect URI's base.
AUTH_URL=http://localhost:3000

# ── Managed services ────────────────────────────────────────────────────────
# The host's PostgreSQL and MongoDB superuser connection strings. Leave either
# blank to run without that section; the API then answers 404 for its routes
# rather than pretending.
#
# The databases carry no TLS by design (databases/README.md), hence sslmode=disable.
#
# The query consoles run as these same accounts — there is no second credential.
# Whoever reaches the panel reaches what a superuser reaches, which for
# PostgreSQL includes the database host: databases/README.md is explicit about it.
ADMIN_POSTGRES_DSN=postgres://replace_user:replace_password@replace_host:5432/postgres?sslmode=disable
ADMIN_MONGO_URI=mongodb://replace_user:replace_password@replace_host:27017/?authSource=admin

# Reading the cluster needs a ServiceAccount or a kubeconfig, and a container has
# neither by default. See the commented volume in admin/compose.yaml.
ADMIN_KUBERNETES_DISABLED=true

# ── Optional ────────────────────────────────────────────────────────────────
# Read each node's disk usage from its kubelet. Off by default: it is the one
# permission here worth a deliberate decision, because disk usage is in neither
# the Kubernetes API nor metrics-server, so the only source is the kubelet — and
# reaching it means a grant that also opens the kubelet's other read endpoints.
# Left off, the panel reports every other node figure and shows the node's
# allocatable ephemeral storage in place of a usage reading, labelled as the
# scheduling ceiling it is. The chart withholds the grant unless this is on.
# ADMIN_KUBERNETES_NODE_STATS=true

# Comma-separated addresses allowed to make changes. Unset means every operator
# who can sign in may write, which is the right default for one person.
# ADMIN_WRITE_EMAILS=you@example.invalid

# ── The assistant ───────────────────────────────────────────────────────────
# Required. `task dev` brings the assistant up with the panel and the API, and
# refuses to start anything without a key rather than leaving you a stack with a
# dead container in it. (In the cluster it is the other way round: the chart
# leaves the agent off unless you ask for it.)
#
# An OpenRouter key: https://openrouter.ai/keys. It is the only credential the
# agent holds — everything else it is trusted with arrives per request, on a
# header the panel attaches.
OPENROUTER_API_KEY=sk-or-replace_me

# Vendor-prefixed, as OpenRouter publishes model ids. There is no bare name there.
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_REASONING=medium

# Where the panel's server finds the agent — and the value depends on which of the
# two development paths you are on, so read this before setting it.
#
# Running the whole stack with `task dev`: set it here, to the SERVICE name.
# Anything in this file reaches the web container, where `localhost` is that
# container and not your machine.
AGENT_URL=http://agent:8080
#
# Running the panel on the host (`npm run dev` in admin/web) against the compose
# agent: export it in that shell instead, where localhost is the published port.
#   AGENT_URL=http://localhost:8080 npm run dev
#
# Unset, the launcher renders nothing — which is what the panel does in a cluster
# with no agent deployed.
