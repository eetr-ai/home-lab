# Copy this file to admin/.env and replace every example value. The real file is
# ignored by Git and holds both a client secret and two superuser passwords, so
# keep it mode 0600 and never paste its contents anywhere.
#
#   cp admin/.env.example admin/.env && chmod 600 admin/.env
#
# Used by `task dev` (admin/compose.yaml) only. The deployed panel reads none of
# this: the chart supplies the same values from Kubernetes Secrets.

# ── Identity ────────────────────────────────────────────────────────────────
# The eetr-auth instance, exactly as it spells its own issuer. The API checks
# tokens against this string, so a trailing slash here and not there rejects
# every token.
OIDC_ISSUER=https://auth.example.invalid

# The confidential client registered in eetr-auth for this panel:
#   - token endpoint auth: client_secret_basic
#   - scopes: openid profile email
#   - redirect URIs: http://localhost:3000/api/auth/callback/eetr
#                    and the deployed panel's equivalent
# Your account must also be granted this client's environment, or eetr-auth
# answers access_denied at /authorize however administrative you are.
OIDC_CLIENT_ID=replace_with_the_client_id
OIDC_CLIENT_SECRET=replace_with_the_client_secret

# Seals the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_string

# The panel's own origin. Must match a registered redirect URI's base.
AUTH_URL=http://localhost:3000

# ── Managed services ────────────────────────────────────────────────────────
# The host's PostgreSQL and MongoDB superuser connection strings. Leave either
# blank to run without that section; the API then answers 404 for its routes
# rather than pretending.
#
# The databases carry no TLS by design (databases/README.md), hence sslmode=disable.
ADMIN_POSTGRES_DSN=postgres://replace_user:replace_password@replace_host:5432/postgres?sslmode=disable
ADMIN_MONGO_URI=mongodb://replace_user:replace_password@replace_host:27017/?authSource=admin

# Reading the cluster needs a ServiceAccount or a kubeconfig, and a container has
# neither by default. See the commented volume in admin/compose.yaml.
ADMIN_KUBERNETES_DISABLED=true

# ── Optional ────────────────────────────────────────────────────────────────
# Comma-separated addresses allowed to make changes. Unset means every operator
# who can sign in may write, which is the right default for one person.
# ADMIN_WRITE_EMAILS=you@example.invalid
