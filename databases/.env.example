DATABASE_BRIDGE_INTERFACE=br0
DATABASE_ALLOWED_CLIENTS=192.0.2.11,192.0.2.12,192.0.2.13
DATABASE_SECRETS_DIR=/absolute/path/outside/repository/database-secrets

POSTGRES_ADMIN_USER=replace_postgres_admin
POSTGRES_DATABASE=replace_postgres_database

MONGO_ADMIN_USER=replace_mongo_admin
