# Copy this file to databases/.env on eetr01 and replace every example value.
# The real file is ignored by Git. Keep it mode 0600.

# Directory on the host that holds the database data directories.
# This is the dedicated 120 GiB vg0/lv-datastore volume, not the 20 GiB
# Docker volume at /srv/docker.
DATABASE_DATA_DIR=/srv/datastore

POSTGRES_ADMIN_USER=replace_postgres_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_long_random_password

MONGO_ADMIN_USER=replace_mongo_admin
MONGO_ADMIN_PASSWORD=replace_with_a_long_random_password
